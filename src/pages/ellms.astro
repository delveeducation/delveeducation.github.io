---
import Layout from '../layouts/Layout.astro';

const program = {
  title: 'Especialista en LLMs',
  subtitle: 'De Fundamentos a Aplicaciones Reales',
  duration: '4 Semanas',
  startDate: '24 de Junio',
  image: '/assets/cursos/ellms_web.png',
  methodImage: '/assets/cursos/ellms_program.png',
};

const learnings = [
  'Fundamentos de Large Language Models (LLMs)',
  'Arquitectura Transformer y mecanismos de atención',
  'Prompt Engineering aplicado a casos reales',
  'Sistemas RAG de alto rendimiento',
  'Fine-tuning y evaluación de modelos',
  'Cuantización e inferencia eficiente para producción',
];

const blocks = [
  {
    num: '01',
    title: 'Fundamentos de LLMs',
    desc: 'Comprenderás cómo funcionan los Large Language Models desde la arquitectura Transformer y los mecanismos de self-attention hasta conceptos fundamentales como embeddings, tokenización y prompting moderno.',
    topics: [
      'Arquitectura Transformer y self-attention',
      'Embeddings y tokenización',
      'Prompt Engineering moderno',
      'Evaluación y benchmarking de LLMs',
    ],
    color: 'var(--accent)',
    colorDim: 'rgba(61,255,182,0.08)',
    colorBorder: 'rgba(61,255,182,0.2)',
  },
  {
    num: '02',
    title: 'LLMs Locales',
    desc: 'Aprenderás a ejecutar modelos open-source de forma local utilizando herramientas modernas para construir aplicaciones prácticas como chatbots, sistemas de clasificación, asistentes inteligentes y generación automática de texto.',
    topics: [
      'Modelos open-source: Llama, Mistral, Phi',
      'Ollama y LM Studio',
      'Chatbots y asistentes locales',
      'Clasificación y resumen automático',
    ],
    color: 'var(--purple)',
    colorDim: 'rgba(167,139,250,0.08)',
    colorBorder: 'rgba(167,139,250,0.2)',
  },
  {
    num: '03',
    title: 'LLMs Avanzado',
    desc: 'Explorarás técnicas avanzadas para optimizar y adaptar modelos de lenguaje utilizando cuantización, LoRA, QLoRA, fine-tuning eficiente e inferencia optimizada para producción.',
    topics: [
      'Cuantización: GGUF, GPTQ',
      'Fine-tuning con LoRA y QLoRA',
      'Inferencia optimizada para producción',
      'RLHF y alineamiento de modelos',
    ],
    color: 'var(--blue)',
    colorDim: 'rgba(96,165,250,0.08)',
    colorBorder: 'rgba(96,165,250,0.2)',
  },
  {
    num: '04',
    title: 'Aplicaciones con LLMs',
    desc: 'Aplicarás los conceptos aprendidos mediante ejercicios guiados, implementación de proyectos prácticos y resolución de casos reales utilizando sistemas modernos basados en LLMs.',
    topics: [
      'Sistemas RAG de alto rendimiento',
      'Agentes y function calling',
      'LangChain y LlamaIndex',
      'Proyecto final: aplicación completa con LLMs',
    ],
    color: '#FCD34D',
    colorDim: 'rgba(252,211,77,0.07)',
    colorBorder: 'rgba(252,211,77,0.2)',
  },
];

const professors = [
  {
    name: 'Martin Arispe',
    image: '/assets/mentores/martin_arispe.jpg',
    initials: 'MA',
    bio: 'Especialista en Inteligencia Artificial con experiencia en Agentes de IA, Large Language Models (LLMs) y Knowledge Graphs. Ha liderado la implementación de flujos de trabajo con Generative AI y plataformas impulsadas por IA. Participó en el proyecto MINTE en Fraunhofer IAIS (Alemania), integrando Deep Learning y Knowledge Graphs.',
    tags: ['LLMs', 'Knowledge Graphs', 'Fraunhofer IAIS'],
    block: 'Bloque 1 y 4',
  },
  {
    name: 'Camilo Bolaños',
    image: '/assets/mentores/camilo_bolanios.png',
    initials: 'CB',
    bio: 'Ingeniero Mecatrónico con una Maestría en Mecatrónica, Robótica e Ingeniería de Automatización por la Universidad de Valladolid. Cuenta con más de 7 años en desarrollo Backend aplicado a soluciones de Inteligencia Artificial en diversos países en Europa.',
    tags: ['LLMs Locales', 'Backend IA', 'Universidad de Valladolid'],
    block: 'Bloque 2',
  },
  {
    name: 'Edison Bejarano',
    image: '/assets/mentores/edison_bejarano.png',
    initials: 'EB',
    bio: 'Ingeniero Aeroespacial con un Máster en Inteligencia Artificial y experiencia en investigación avanzada en modelos de lenguaje aplicados a robótica en la UPC. Actualmente trabaja en el desarrollo de soluciones de IA y LLMs en el ITCL, combinando investigación académica con aplicaciones tecnológicas en entornos industriales reales.',
    tags: ['Fine-tuning', 'LLMs Avanzado', 'UPC / ITCL'],
    block: 'Bloque 3',
  },
  {
    name: 'Fernando Silva',
    image: '/assets/mentores/fernando_silva.jpg',
    initials: 'FS',
    bio: 'Ingeniero en sistemas con un máster en inteligencia artificial realizado en Europa. Tiene experiencia en proyectos de machine learning, visión por computadora y procesamiento de lenguaje natural en empresas y organizaciones en Latinoamérica y Europa.',
    tags: ['Machine Learning', 'NLP', 'Computer Vision'],
    block: 'Bloque 4',
  },
];
---

<Layout
  title="Especialista en LLMs — Programa"
  description="Aprende a construir aplicaciones modernas con LLMs, RAG y optimización avanzada. Programa de 4 semanas con mentores internacionales."
>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href="/">Inicio</a>
    <span>›</span>
    <a href="/cursos">Cursos</a>
    <span>›</span>
    <span class="bc-cur">Especialista en LLMs</span>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-top-badges">
        <span class="prog-badge">PROGRAMA</span>
        <span class="start-badge">🗓 Inicio: {program.startDate}</span>
      </div>

      <h1>Especialista en<br /><em>Large Language Models</em></h1>
      <p class="hero-sub">{program.subtitle} · {program.duration}</p>
      <p class="hero-desc">
        Aprende a construir aplicaciones modernas con LLMs, RAG
        y optimización avanzada. Desde fundamentos hasta producción.
      </p>

      <div class="hero-stats">
        <div class="hs"><span class="hs-n">4</span><span class="hs-l">Bloques</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">4</span><span class="hs-l">Semanas</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">4</span><span class="hs-l">Profesores</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">✓</span><span class="hs-l">Certificado</span></div>
      </div>

      <div class="hero-actions">
        <a href="https://forms.gle/a3DNbm1M18VFgvpj7" target="_blank" class="btn-primary btn-lg">
          Inscribirme ahora
        </a>
        <a href="#bloques" class="btn-secondary">Ver contenido →</a>
      </div>

      <div class="trust-row">
        <span>✔ Acceso anual</span>
        <span>✔ Certificado oficial Delve</span>
        <span>✔ Blended Learning</span>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-img-wrap">
        <img src={program.image} alt="Especialista en LLMs" />
        <div class="hero-img-overlay">
          <div class="overlay-prof-list">
            <span class="op-label">Profesores</span>
            <span class="op-names">Martin Arispe · Camilo Bolaños · Edison Bejarano · Fernando Silva</span>
          </div>
        </div>
      </div>

      <div class="floating-cta">
        <div class="fca-price-row">
          <div>
            <div class="fca-price">$99<span> USD</span></div>
            <div class="fca-note">Pago único · Acceso anual</div>
          </div>
          <div class="fca-start">
            <span class="start-label">Inicio</span>
            <span class="start-date">{program.startDate}</span>
          </div>
        </div>
        <a href="https://forms.gle/a3DNbm1M18VFgvpj7" target="_blank" class="btn-primary fca-btn">
          Inscribirme ahora
        </a>
        <div class="fca-includes">
          <div class="fca-inc-title">El programa incluye:</div>
          <ul>
            <li>4 bloques de contenido estructurado</li>
            <li>Sesiones en vivo con los profesores</li>
            <li>Proyectos prácticos guiados</li>
            <li>Certificado oficial verificable</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- LO QUE APRENDERÁS -->
  <section class="section learnings-section">
    <div class="learnings-inner">
      <div>
        <span class="label">Resultados de aprendizaje</span>
        <h2 class="section-title">Lo que aprenderás</h2>
      </div>
      <div class="learnings-grid">
        {learnings.map(item => (
          <div class="learning-item">
            <span class="l-check">→</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOQUES -->
  <section class="section blocks-section" id="bloques">
    <span class="label">Plan de estudio</span>
    <h2 class="section-title">Contenido del programa</h2>

    <div class="blocks-grid">
      {blocks.map(b => (
        <div
          class="block-card"
          style={`--b-color:${b.color}; --b-dim:${b.colorDim}; --b-border:${b.colorBorder};`}
        >
          <div class="block-header">
            <div class="block-num-wrap">
              <span class="block-num">{b.num}</span>
            </div>
            <div>
              <div class="block-week">Bloque {b.num}</div>
              <h3 class="block-title">{b.title}</h3>
            </div>
          </div>
          <p class="block-desc">{b.desc}</p>
          <ul class="block-topics">
            {b.topics.map(t => (
              <li><span class="t-arrow">→</span>{t}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- DESCRIPCIÓN -->
  <section class="section desc-section">
    <div class="desc-inner">
      <div>
        <span class="label">Sobre el programa</span>
        <h2 class="section-title">Descripción</h2>
      </div>
      <p class="desc-text">
        Desarrollarás una comprensión sólida de los Large Language Models (LLMs), desde sus fundamentos
        teóricos hasta técnicas modernas utilizadas en sistemas de inteligencia artificial generativa.
        A lo largo del programa aprenderás a trabajar con modelos open-source, construir sistemas RAG,
        optimizar inferencia mediante cuantización y desplegar aplicaciones reales tanto en entornos
        locales como escalables. El programa combina fundamentos técnicos con implementación práctica,
        permitiéndote desarrollar experiencia aplicada en tecnologías modernas utilizadas en la industria de IA.
      </p>
    </div>
  </section>

  <!-- METODOLOGÍA -->
  <section class="section method-section">
    <div class="method-inner">
      <div class="method-text">
        <span class="label">Cómo aprenderás</span>
        <h2 class="section-title">Metodología</h2>
        <p>
          El programa sigue una metodología de <strong>Blended Learning</strong> que integra aprendizaje
          autónomo con sesiones prácticas en vivo. A través de contenido audiovisual estructurado y
          sesiones asincrónicas, avanzarás progresivamente en el desarrollo de fundamentos teóricos
          y habilidades técnicas.
        </p>
        <p>
          Las clases en tiempo real estarán enfocadas en implementación práctica, resolución de dudas
          y construcción de proyectos guiados, consolidando el aprendizaje en un entorno aplicado y colaborativo.
        </p>
        <div class="method-pills">
          <span class="method-pill">📹 Contenido asincrónico</span>
          <span class="method-pill">🎯 Sesiones en vivo</span>
          <span class="method-pill">🛠 Proyectos prácticos</span>
          <span class="method-pill">👥 Comunidad activa</span>
        </div>
      </div>
      <div class="method-img-wrap">
        <img src={program.methodImage} alt="Metodología del programa" />
      </div>
    </div>
  </section>

  <!-- PROFESORES -->
  <section class="section professors-section">
    <span class="label">El equipo docente</span>
    <h2 class="section-title">Profesores del programa</h2>

    <div class="professors-grid">
      {professors.map(prof => (
        <div class="prof-card">
          <div class="prof-img-wrap">
            <img
              src={prof.image}
              alt={prof.name}
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <div class="prof-avatar-fallback">{prof.initials}</div>
          </div>
          <div class="prof-info">
            <div class="prof-name-row">
              <h3>{prof.name}</h3>
              <span class="block-tag">{prof.block}</span>
            </div>
            <p class="prof-bio">{prof.bio}</p>
            <div class="prof-tags">
              {prof.tags.map(t => <span class="prof-tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section bottom-cta-section">
    <div class="bottom-cta">
      <div class="cta-badge">🗓 Inicio: {program.startDate}</div>
      <h2>¿Listo para convertirte en Especialista en LLMs?</h2>
      <p>4 semanas · 4 profesores · Proyectos reales · Certificado oficial</p>
      <div class="bottom-btns">
        <a href="https://forms.gle/a3DNbm1M18VFgvpj7" target="_blank" class="btn-primary btn-lg">
          Inscribirme ahora
        </a>
        <a href="/cursos" class="btn-secondary">Ver todos los cursos</a>
      </div>
      <p class="cta-sub">$99 USD · Pago único · Acceso anual</p>
    </div>
  </section>

</Layout>

<style>
  /* BREADCRUMB */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px var(--px);
    font-size: 12px;
    color: var(--text-muted);
    border-bottom: 0.5px solid var(--border);
  }
  .breadcrumb a { color: var(--text-muted); transition: color .15s; }
  .breadcrumb a:hover { color: var(--accent); }
  .bc-cur { color: var(--text-secondary); }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 56px;
    padding: 64px var(--px) 72px;
    border-bottom: 0.5px solid var(--border);
    align-items: start;
  }

  .hero-top-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .prog-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--accent);
    background: var(--accent-dim);
    border: 0.5px solid var(--accent-border);
    padding: 4px 12px;
    border-radius: 4px;
  }

  .start-badge {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    border: 0.5px solid var(--border-hover);
    padding: 4px 12px;
    border-radius: 20px;
  }

  .hero-left h1 {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -2px;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 12px;
  }
  .hero-left h1 em { color: var(--accent); font-style: normal; }

  .hero-sub {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.3px;
  }

  .hero-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.75;
    font-weight: 300;
    margin-bottom: 32px;
    max-width: 500px;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    margin-bottom: 36px;
    background: rgba(255,255,255,.03);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: fit-content;
  }
  .hs { display: flex; flex-direction: column; align-items: center; padding: 16px 24px; gap: 4px; }
  .hs-n { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: #fff; }
  .hs-l { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; }
  .hs-div { width: 0.5px; height: 40px; background: var(--border); }

  .hero-actions { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .btn-lg { padding: 15px 32px; font-size: 15px; }
  .trust-row { display: flex; gap: 20px; flex-wrap: wrap; font-size: 13px; color: var(--text-muted); }

  /* HERO RIGHT */
  .hero-right { display: flex; flex-direction: column; gap: 16px; }

  .hero-img-wrap {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 0.5px solid var(--border);
    position: relative;
  }
  .hero-img-wrap img { width: 100%; height: 240px; object-fit: cover; display: block; }

  .hero-img-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(5,10,20,0.9) 0%, transparent 100%);
    padding: 20px 16px 14px;
  }
  .op-label { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin-bottom: 4px; }
  .op-names { font-size: 12px; color: rgba(255,255,255,0.65); line-height: 1.4; }

  .floating-cta {
    background: rgba(255,255,255,.03);
    border: 0.5px solid rgba(255,255,255,.12);
    border-radius: var(--radius-xl);
    padding: 24px;
  }

  .fca-price-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
    gap: 12px;
  }
  .fca-price {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    margin-bottom: 4px;
  }
  .fca-price span { font-size: 16px; font-weight: 400; color: var(--text-muted); }
  .fca-note { font-size: 12px; color: var(--text-muted); }

  .fca-start { text-align: right; }
  .start-label { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 4px; }
  .start-date { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--accent); }

  .fca-btn { display: block; text-align: center; width: 100%; padding: 13px; margin-bottom: 20px; font-size: 14px; }
  .fca-includes { border-top: 0.5px solid var(--border); padding-top: 16px; }
  .fca-inc-title { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; }
  .fca-includes ul { display: flex; flex-direction: column; gap: 6px; }
  .fca-includes li { font-size: 13px; color: var(--text-secondary); display: flex; gap: 8px; align-items: center; }
  .fca-includes li::before { content: '→'; color: var(--accent); font-size: 11px; }

  /* SECTIONS */
  .section { padding: 72px var(--px); }

  /* LEARNINGS */
  .learnings-section { background: rgba(255,255,255,.01); border-bottom: 0.5px solid var(--border); }
  .learnings-inner { display: grid; grid-template-columns: 260px 1fr; gap: 64px; align-items: start; }
  .learnings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .learning-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(255,255,255,.03);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .l-check { color: var(--accent); flex-shrink: 0; font-size: 12px; margin-top: 1px; }

  /* BLOCKS */
  .blocks-section { border-bottom: 0.5px solid var(--border); }

  .blocks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .block-card {
    background: var(--b-dim, rgba(255,255,255,0.02));
    border: 0.5px solid var(--b-border, rgba(255,255,255,0.08));
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.2s;
  }
  .block-card:hover { border-color: var(--b-color); }

  .block-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .block-num-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--b-dim);
    border: 0.5px solid var(--b-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .block-num {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--b-color, var(--accent));
  }

  .block-week {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--b-color, var(--accent));
    margin-bottom: 4px;
  }
  .block-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
  }

  .block-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .block-topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 0.5px solid rgba(255,255,255,0.06);
    padding-top: 14px;
  }
  .block-topics li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--text-secondary);
    padding: 6px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.04);
  }
  .block-topics li:last-child { border-bottom: none; }
  .t-arrow { color: var(--b-color, var(--accent)); font-size: 10px; flex-shrink: 0; }

  /* DESCRIPTION */
  .desc-section { background: rgba(255,255,255,.01); border-bottom: 0.5px solid var(--border); }
  .desc-inner { display: grid; grid-template-columns: 260px 1fr; gap: 64px; align-items: start; }
  .desc-text { font-size: 15px; color: var(--text-secondary); line-height: 1.8; font-weight: 300; }

  /* METHODOLOGY */
  .method-section { border-bottom: 0.5px solid var(--border); }
  .method-inner {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 64px;
    align-items: center;
  }
  .method-text p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 16px;
    font-weight: 300;
  }
