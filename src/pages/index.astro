    meta: '5 horas · Asincrónico',
    href: '/pp',
  },
];

const plans = [
  {
    name: 'Curso individual',
    sub: 'Entrada sin riesgo',
    price: '$10',
    period: ' USD',
    bob: 'Bs 100',
    bobPeriod: '',
    features: ['1 curso completo (5 h)', 'Acceso anual', 'Certificado de finalización'],
    cta: 'Elegir curso',
    href: 'https://forms.gle/fknvV9x2rLHyrF4N7',
    featured: false,
  },
  {
    name: 'Acceso Founder',
    sub: 'Precio de lanzamiento',
    price: '$79',
    period: ' USD/año',
    bob: 'Bs 790',
    bobPeriod: '/año',
    features: ['Acceso a todos los cursos', 'Nuevos cursos incluidos', 'Acceso anual', 'Certificados de todos los cursos', 'Cupos limitados'],
    cta: 'Suscribirme',
    href: 'https://forms.gle/fknvV9x2rLHyrF4N7',
    featured: true,
    badge: 'Más popular',
  },
  {
    name: 'Programa + mentoría',
    sub: 'Especialización',
    price: '$99',
    period: ' USD único',
    bob: 'Bs 990',
    bobPeriod: ' pago único',
    features: ['3 cursos del área elegida', '4 sesiones de mentoría en vivo', 'Proyecto final con feedback', 'Certificado de especialización'],
    cta: 'Ver programa',
    href: '/ellms',
    featured: false,
  },
];

const mentors = [
  { initials: 'AA', name: 'Adrián Arnaiz',    role: 'IA Research',  color: 'var(--accent)' },
  { initials: 'AR', name: 'Adriana Romero',   role: 'ML Engineer',  color: 'var(--purple)' },
  { initials: 'ER', name: 'Emily Rivera',     role: 'DeepTech',     color: 'var(--blue)' },
  { initials: 'DS', name: 'Danae Sanchez',    role: 'Data Science', color: '#FCD34D' },
  { initials: 'MA', name: 'Martin Arispe',    role: 'Quantum',      color: '#FCA5A5' },
  { initials: 'JG', name: 'Juan Guillermo',   role: 'AI Engineer',  color: 'var(--accent)' },
  { initials: 'JP', name: 'Juan P. Morales',  role: 'ML Research',  color: 'var(--purple)' },
];
---

<Layout title="Domina las tecnologías DeepTech">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-badge">
        <span class="dot"></span>
        DeepTech en español · Latinoamérica
      </div>
      <h1>Domina las tecnologías<br />que <em>cambian el mundo</em></h1>
      <p>IA, computación cuántica y programación avanzada.<br />Con mentores que trabajan en empresas top globales.</p>
      <div class="hero-btns">
        <a href="https://forms.gle/fknvV9x2rLHyrF4N7" target="_blank" class="btn-primary" id="hero-cta">
          Acceso Founder — $79 USD/año
        </a>
        <a href="/cursos" class="btn-secondary">Ver cursos →</a>
      </div>
      <div class="hero-stats">
        {stats.map(s => (
          <div class="stat">
            <div class="stat-num">{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- DeepTech visual -->
    <div class="hero-visual" aria-hidden="true">
      <svg viewBox="0 0 520 480" xmlns="http://www.w3.org/2000/svg" class="deeptech-svg">
        <defs>
          <radialGradient id="glow-green" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#3DFFB6" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#3DFFB6" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="glow-purple" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#A78BFA" stop-opacity="0"/>
          </radialGradient>
          <radialGradient id="glow-blue" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#60A5FA" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#60A5FA" stop-opacity="0"/>
          </radialGradient>
          <filter id="blur-sm">
            <feGaussianBlur stdDeviation="1.5"/>
          </filter>
        </defs>

        <!-- Background glow blobs -->
        <ellipse cx="260" cy="200" rx="200" ry="180" fill="url(#glow-green)"/>
        <ellipse cx="380" cy="340" rx="140" ry="120" fill="url(#glow-purple)"/>
        <ellipse cx="140" cy="360" rx="120" ry="100" fill="url(#glow-blue)"/>

        <!-- Grid lines -->
        {Array.from({length: 9}, (_, i) => (
          <line x1={i * 65} y1="0" x2={i * 65} y2="480" stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
        ))}
        {Array.from({length: 8}, (_, i) => (
          <line x1="0" y1={i * 68} x2="520" y2={i * 68} stroke="rgba(255,255,255,0.03)" stroke-width="1"/>
        ))}

        <!-- Connection lines layer 1→2 -->
        <g stroke="rgba(61,255,182,0.12)" stroke-width="1">
          <line x1="80" y1="140" x2="200" y2="100"/>
          <line x1="80" y1="140" x2="200" y2="180"/>
          <line x1="80" y1="140" x2="200" y2="260"/>
          <line x1="80" y1="220" x2="200" y2="100"/>
          <line x1="80" y1="220" x2="200" y2="180"/>
          <line x1="80" y1="220" x2="200" y2="260"/>
          <line x1="80" y1="300" x2="200" y2="100"/>
          <line x1="80" y1="300" x2="200" y2="180"/>
          <line x1="80" y1="300" x2="200" y2="260"/>
        </g>
        <g stroke="rgba(61,255,182,0.35)" stroke-width="1.5">
          <line x1="80" y1="220" x2="200" y2="180"/>
          <line x1="200" y1="180" x2="320" y2="200"/>
        </g>

        <!-- Connection lines layer 2→3 -->
        <g stroke="rgba(167,139,250,0.12)" stroke-width="1">
          <line x1="200" y1="100" x2="320" y2="140"/>
          <line x1="200" y1="100" x2="320" y2="200"/>
          <line x1="200" y1="100" x2="320" y2="260"/>
          <line x1="200" y1="180" x2="320" y2="140"/>
          <line x1="200" y1="180" x2="320" y2="200"/>
          <line x1="200" y1="180" x2="320" y2="260"/>
          <line x1="200" y1="260" x2="320" y2="140"/>
          <line x1="200" y1="260" x2="320" y2="200"/>
          <line x1="200" y1="260" x2="320" y2="260"/>
        </g>

        <!-- Connection lines layer 3→4 -->
        <g stroke="rgba(96,165,250,0.15)" stroke-width="1">
          <line x1="320" y1="140" x2="440" y2="200"/>
          <line x1="320" y1="200" x2="440" y2="200"/>
          <line x1="320" y1="260" x2="440" y2="200"/>
        </g>
        <line x1="320" y1="200" x2="440" y2="200" stroke="rgba(96,165,250,0.5)" stroke-width="2"/>

        <!-- Layer 1: Input nodes -->
        <g>
          <circle cx="80" cy="140" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(61,255,182,0.6)" stroke-width="1.5"/>
          <text x="80" y="145" text-anchor="middle" fill="#3DFFB6" font-size="11" font-family="monospace">x₁</text>
          <circle cx="80" cy="220" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(61,255,182,0.8)" stroke-width="2"/>
          <circle cx="80" cy="220" r="10" fill="rgba(61,255,182,0.15)"/>
          <text x="80" y="225" text-anchor="middle" fill="#3DFFB6" font-size="11" font-family="monospace">x₂</text>
          <circle cx="80" cy="300" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(61,255,182,0.5)" stroke-width="1.5"/>
          <text x="80" y="305" text-anchor="middle" fill="#3DFFB6" font-size="11" font-family="monospace">x₃</text>
        </g>

        <!-- Layer 2: Hidden 1 -->
        <g>
          <circle cx="200" cy="100" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.5)" stroke-width="1.5"/>
          <text x="200" y="105" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₁</text>
          <circle cx="200" cy="180" r="20" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.9)" stroke-width="2"/>
          <circle cx="200" cy="180" r="11" fill="rgba(167,139,250,0.18)"/>
          <text x="200" y="185" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₂</text>
          <circle cx="200" cy="260" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.5)" stroke-width="1.5"/>
          <text x="200" y="265" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₃</text>
        </g>

        <!-- Layer 3: Hidden 2 -->
        <g>
          <circle cx="320" cy="140" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.45)" stroke-width="1.5"/>
          <text x="320" y="145" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₄</text>
          <circle cx="320" cy="200" r="20" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.85)" stroke-width="2"/>
          <circle cx="320" cy="200" r="11" fill="rgba(167,139,250,0.15)"/>
          <text x="320" y="205" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₅</text>
          <circle cx="320" cy="260" r="18" fill="rgba(5,10,20,0.9)" stroke="rgba(167,139,250,0.45)" stroke-width="1.5"/>
          <text x="320" y="265" text-anchor="middle" fill="#A78BFA" font-size="10" font-family="monospace">h₆</text>
        </g>

        <!-- Layer 4: Output -->
        <circle cx="440" cy="200" r="24" fill="rgba(5,10,20,0.9)" stroke="rgba(96,165,250,0.9)" stroke-width="2.5"/>
        <circle cx="440" cy="200" r="14" fill="rgba(96,165,250,0.15)"/>
        <text x="440" y="205" text-anchor="middle" fill="#60A5FA" font-size="13" font-family="monospace">ŷ</text>

        <!-- Layer labels -->
        <text x="80" y="350" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="10" font-family="monospace">Input</text>
        <text x="200" y="320" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="10" font-family="monospace">Hidden 1</text>
        <text x="320" y="310" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="10" font-family="monospace">Hidden 2</text>
        <text x="440" y="246" text-anchor="middle" fill="rgba(255,255,255,0.25)" font-size="10" font-family="monospace">Output</text>

        <!-- Floating Cards -->
        <g transform="translate(30, 370)">
          <rect width="140" height="52" rx="8" fill="rgba(61,255,182,0.08)" stroke="rgba(61,255,182,0.25)" stroke-width="1"/>
          <text x="18" y="30" text-anchor="middle" fill="#3DFFB6" font-size="12">🤖</text>
          <text x="34" y="22" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Inteligencia</text>
          <text x="34" y="36" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Artificial</text>
        </g>
        <g transform="translate(190, 390)">
          <rect width="140" height="52" rx="8" fill="rgba(167,139,250,0.08)" stroke="rgba(167,139,250,0.25)" stroke-width="1"/>
          <text x="18" y="30" text-anchor="middle" fill="#A78BFA" font-size="12">⚛️</text>
          <text x="34" y="22" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Computación</text>
          <text x="34" y="36" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Cuántica</text>
        </g>
        <g transform="translate(350, 370)">
          <rect width="130" height="52" rx="8" fill="rgba(96,165,250,0.08)" stroke="rgba(96,165,250,0.25)" stroke-width="1"/>
          <text x="18" y="30" text-anchor="middle" fill="#60A5FA" font-size="12">{'</>'}</text>
          <text x="34" y="22" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Programación</text>
          <text x="34" y="36" fill="rgba(255,255,255,0.8)" font-size="11" font-family="sans-serif">Avanzada</text>
        </g>

        <!-- Animated pulses -->
        <circle cx="200" cy="180" r="28" fill="none" stroke="rgba(167,139,250,0.2)" stroke-width="1">
          <animate attributeName="r" values="20;34;20" dur="3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.4;0;0.4" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="440" cy="200" r="32" fill="none" stroke="rgba(96,165,250,0.2)" stroke-width="1">
          <animate attributeName="r" values="24;40;24" dur="2.5s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.4;0;0.4" dur="2.5s" repeatCount="indefinite"/>
        </circle>

        <!-- Floating particles -->
        <circle cx="145" cy="155" r="2.5" fill="rgba(61,255,182,0.6)">
          <animate attributeName="cy" values="155;148;155" dur="2s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.6;1;0.6" dur="2s" repeatCount="indefinite"/>
        </circle>
        <circle cx="265" cy="170" r="2" fill="rgba(167,139,250,0.6)">
          <animate attributeName="cy" values="170;163;170" dur="2.8s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;1;0.5" dur="2.8s" repeatCount="indefinite"/>
        </circle>
        <circle cx="385" cy="175" r="2.5" fill="rgba(96,165,250,0.6)">
          <animate attributeName="cy" values="175;168;175" dur="2.3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.6;1;0.6" dur="2.3s" repeatCount="indefinite"/>
        </circle>
      </svg>
    </div>
  </section>

  <!-- CURSOS DESTACADOS -->
  <section class="section courses-section">
    <span class="label">Oferta educativa</span>
    <h2 class="section-title">Cursos destacados</h2>
    <div class="courses-grid">
      {courses.map(c => (
        <a href={c.href} class="course-card">
          <span class={`tag ${c.tagClass}`}>{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <div class="course-meta">
            <span>{c.meta}</span>
            <span class="course-link">Ver curso →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="courses-cta">
      <a href="/cursos" class="btn-secondary">Ver todos los cursos</a>
    </div>
  </section>

  <!-- PRICING -->
  <section id="precios" class="section pricing-section">
    <span class="label">Planes</span>
    <h2 class="section-title">Elige tu acceso</h2>
    <div class="pricing-grid">
      {plans.map(p => (
        <div class:list={['price-card', { featured: p.featured }]}>
          {p.badge && <span class="badge">{p.badge}</span>}
          <h3>{p.name}</h3>
          <p class="plan-sub">{p.sub}</p>
          <div class="price">
            <span class="price-amount" data-usd={p.price} data-bob={p.bob}>{p.price}</span>
            <span class="price-period" data-usd-period={p.period} data-bob-period={p.bobPeriod}>{p.period}</span>
          </div>
          <ul class="price-features">
            {p.features.map(f => <li>{f}</li>)}
          </ul>
          <a
            href={p.href}
            class:list={[p.featured ? 'btn-primary' : 'btn-secondary', 'plan-btn']}
            target={p.href.startsWith('http') ? '_blank' : undefined}
          >
            {p.cta}
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- MENTORES -->
  <section class="section mentors-section">
    <span class="label">Quiénes enseñan</span>
    <h2 class="section-title">Mentores internacionales</h2>
    <div class="mentors-row">
      {mentors.map(m => (
        <div class="mentor-chip">
          <div class="mentor-avatar" style={`color: ${m.color}`}>{m.initials}</div>
          <div>
            <div class="mentor-name">{m.name}</div>
            <div class="mentor-role">{m.role}</div>
          </div>
        </div>
      ))}
      <a href="/nosotros" class="mentor-chip mentor-more">
        <div class="mentor-avatar" style="color: var(--accent)">+8</div>
        <div>
          <div class="mentor-name">Ver todos</div>
          <div class="mentor-role">los mentores</div>
        </div>
      </a>
    </div>
  </section>

  <!-- B2B CTA BANNER -->
  <section class="section b2b-banner">
    <div class="b2b-inner">
      <div>
        <h2>¿Eres empresa, colegio o universidad?</h2>
        <p>Capacita a tu equipo en DeepTech con programas a medida. Piloto gratuito de 30 días.</p>
      </div>
      <a href="/empresas" class="btn-primary">Ver planes institucionales →</a>
    </div>
  </section>

</Layout>

<script>
  async function detectCountry(): Promise<string | null> {
    try {
      const res = await fetch('https://ipapi.co/json/');
      const data = await res.json();
      return data.country_code ?? null;
    } catch {
      return null;
    }
  }

  function applyBolivianPrices() {
    // Precios en tarjetas
    document.querySelectorAll('.price-amount').forEach(el => {
      const bob = el.getAttribute('data-bob');
      if (bob) el.textContent = bob;
    });

    document.querySelectorAll('.price-period').forEach(el => {
      const bobPeriod = el.getAttribute('data-bob-period');
      if (bobPeriod !== null) el.textContent = bobPeriod;
    });

    // Botón hero
    const heroBtn = document.getElementById('hero-cta');
    if (heroBtn) heroBtn.textContent = 'Acceso Founder — Bs 790/año';
  }

  detectCountry().then(country => {
    if (country === 'BO') applyBolivianPrices();
  });
</script>

<style>
  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 0;
    border-bottom: 0.5px solid var(--border);
    min-height: 560px;
    overflow: hidden;
  }

  .hero-left {
    padding: 80px var(--px) 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-dim);
    border: 0.5px solid var(--accent-border);
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 12px;
    color: var(--accent);
    margin-bottom: 32px;
    width: fit-content;
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }

  .hero-left h1 {
    font-family: var(--font-display);
    font-size: 58px;
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -2.5px;
    color: #fff;
    max-width: 640px;
    margin-bottom: 24px;
  }

  .hero-left h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .hero-left > p {
    font-size: 17px;
    color: var(--text-secondary);
    max-width: 440px;
    line-height: 1.7;
    margin-bottom: 40px;
    font-weight: 300;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 48px;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 0.5px solid var(--border);
    flex-wrap: wrap;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: #fff;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }

  /* HERO VISUAL */
  .hero-visual {
    position: relative;
    background: radial-gradient(ellipse at 40% 40%, rgba(61,255,182,0.04) 0%, transparent 65%),
                radial-gradient(ellipse at 80% 70%, rgba(167,139,250,0.05) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(96,165,250,0.04) 0%, transparent 55%);
    border-left: 0.5px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .deeptech-svg {
    width: 100%;
    height: 100%;
    max-width: 520px;
    padding: 32px;
  }

  /* COURSES */
  .section {
    padding: 72px var(--px);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .course-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: border-color 0.2s, background 0.2s;
  }

