---
import Layout from '../layouts/Layout.astro';

const mentors = [
  { initials: 'AA', name: 'Adrián Arnaiz',       role: 'IA Research',         color: 'var(--accent)' },
  { initials: 'AR', name: 'Adriana Romero',       role: 'ML Engineer',         color: 'var(--purple)' },
  { initials: 'ER', name: 'Emily Rivera',         role: 'DeepTech',            color: 'var(--blue)' },
  { initials: 'CB', name: 'Camilo Bolaños',       role: 'Data Science',        color: '#FCD34D' },
  { initials: 'DS', name: 'Danae Sanchez',        role: 'AI Research',         color: '#FCA5A5' },
  { initials: 'DA', name: 'Diego Angulo',         role: 'ML Engineering',      color: 'var(--accent)' },
  { initials: 'EM', name: 'Erick Maraz',          role: 'Deep Learning',       color: 'var(--purple)' },
  { initials: 'FS', name: 'Felipe San Martin',    role: 'AI Product',          color: 'var(--blue)' },
  { initials: 'HC', name: 'Hodei Calvo',          role: 'Quantum Computing',   color: '#FCD34D' },
  { initials: 'JB', name: 'Jaume Brossa',         role: 'AI Strategy',         color: '#FCA5A5' },
  { initials: 'JG', name: 'Juan Gomez R.',        role: 'ML Research',         color: 'var(--accent)' },
  { initials: 'JGu', name: 'Juan Guillermo',      role: 'NLP Engineer',        color: 'var(--purple)' },
  { initials: 'JP', name: 'Juan Pablo Morales',   role: 'Data Engineering',    color: 'var(--blue)' },
  { initials: 'MA', name: 'Martin Arispe',        role: 'Quantum Algorithms',  color: '#FCD34D' },
  { initials: 'MV', name: 'Merce Vintro',         role: 'AI Ethics',           color: '#FCA5A5' },
  { initials: 'OC', name: 'Oscar Contreras',      role: 'Computer Vision',     color: 'var(--accent)' },
  { initials: 'PF', name: 'Pau Fargas',           role: 'Robotics & AI',       color: 'var(--purple)' },
];
---

<Layout title="Nosotros" description="Somos un equipo multidisciplinario enfocado en DeepTech, impulsando a Latinoamérica en tecnologías avanzadas.">

  <section class="hero-section">
    <span class="label">Quiénes somos</span>
    <h1>Somos un equipo <em>DeepTech</em></h1>
    <p>Un equipo multidisciplinario con un objetivo en común: impulsar a Latinoamérica para que juegue un papel relevante en el desarrollo y aplicación de tecnologías avanzadas.</p>
    <div class="accel-row">
      <span>Acelerado por</span>
      <span class="accel-name">Aceleratec</span>
    </div>
  </section>

  <section class="section mentors-section">
    <span class="label">El equipo docente</span>
    <h2 class="section-title">Mentores y especialistas</h2>
    <p class="section-desc">Profesionales que han impulsado nuestra comunidad desde la etapa de Saturdays AI La Paz hasta la consolidación de Delve Educación.</p>
    <div class="mentors-grid">
      {mentors.map(m => (
        <div class="mentor-card">
          <div class="mentor-av" style={`color: ${m.color}`}>{m.initials}</div>
          <div class="mentor-name">{m.name}</div>
          <div class="mentor-role">{m.role}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section mission-section">
    <div class="mission-grid">
      <div class="mission-card">
        <span class="mission-icon">🎯</span>
        <h3>Misión</h3>
        <p>Democratizar el acceso a educación DeepTech de calidad en Latinoamérica, formando a la próxima generación de líderes tecnológicos de la región.</p>
      </div>
      <div class="mission-card">
        <span class="mission-icon">🔭</span>
        <h3>Visión</h3>
        <p>Un Latinoamérica donde las empresas y profesionales locales lideren el desarrollo y aplicación de IA, computación cuántica y otras tecnologías avanzadas.</p>
      </div>
      <div class="mission-card">
        <span class="mission-icon">⚡</span>
        <h3>Por qué existimos</h3>
        <p>La brecha de habilidades DeepTech en LATAM es real. Hay talento, hay ambición, pero falta formación en español con contexto local y mentores de clase mundial.</p>
      </div>
    </div>
  </section>

  <section class="section b2b-banner">
    <div class="b2b-inner">
      <div>
        <h2>¿Tienes dudas? Envíanos un mensaje</h2>
        <br>
      </div>
      <a href="https://api.whatsapp.com/send?phone=+59178853748&text=Hola,%20tengo%20una%20consulta&fbclid=IwY2xjawG0bG9leHRuA2FlbQIxMAABHePwSPJvEKzYupVcWIWylc4yJrMuXr-qiFOw0hSW-j65Yprs4OO3VDIRPQ_aem_6lFLvVNB5nF3ZoS18rsrfw" class="btn-primary">WhatsApp</a>
    </div>
  </section>

</Layout>

<style>
  .hero-section {
    padding: 80px var(--px) 64px;
    border-bottom: 0.5px solid var(--border);
    max-width: 680px;
  }

  .hero-section h1 {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -2px;
    color: #fff;
    margin-bottom: 20px;
    line-height: 1.05;
  }

  .hero-section h1 em { color: var(--accent); font-style: normal; }

  .hero-section p {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 32px;
    font-weight: 300;
  }

  .accel-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .accel-name {
    color: var(--text-secondary);
    border: 0.5px solid var(--border-hover);
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 500;
  }

  .section { padding: 72px var(--px); }

  .section-desc {
    font-size: 15px;
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 40px;
    margin-top: -20px;
    font-weight: 300;
  }

  .mentors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }

  .mentor-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px 16px;
    text-align: center;
    transition: border-color 0.2s, background 0.2s;
  }

  .mentor-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface-hover);
  }

  .mentor-av {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    margin: 0 auto 12px;
  }

  .mentor-name {
    font-size: 13px;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    margin-bottom: 4px;
  }

  .mentor-role {
    font-size: 11px;
    color: var(--text-muted);
  }

  .mission-section {
    border-top: 0.5px solid var(--border);
    background: rgba(255,255,255,0.01);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .mission-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .mission-icon { font-size: 24px; display: block; margin-bottom: 16px; }

  .mission-card h3 {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .mission-card p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .mission-grid { grid-template-columns: 1fr; }
    .mentors-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  }

  @media (max-width: 768px) {
    .hero-section h1 { font-size: 36px; }
    .hero-section { max-width: 100%; }
  }
</style>