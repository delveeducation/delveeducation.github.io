---
import Layout from '../layouts/Layout.astro';

const course = {
  title: 'Large Language Models Locales',
  subtitle: 'Aprende a ejecutar y optimizar modelos LLMs localmente, sin depender de la nube.',
  level: 'Intermedio',
  hours: '5 horas',
  area: 'Inteligencia Artificial',
  tagClass: 'tag-ai',
  image: '/assets/cursos/large_language_models_locales.png',
};

const professor = {
  name: 'Camilo Bolaños',
  image: '/assets/mentores/camilo_bolanios.png',
  initials: 'CB',
  bio: 'Ingeniero Mecatrónico con una Maestría en Mecatrónica, Robótica e Ingeniería de Automatización por la Universidad de Valladolid. Cuenta con más de 7 años en desarrollo Backend aplicado a soluciones de Inteligencia Artificial en diversos países en Europa.',
  tags: ["LLMs", "Backend", "Universidad de Valladolid"],
};

const learnings = ["Configurar entornos locales para correr LLMs", "Construir un chatbot desde la terminal", "Generar texto y personalizar resultados con modelos preentrenados", "Aplicar modelos para clasificación y resumen automático", "Optimizar el uso de LLMs en hardware limitado (CPU o GPU)"];

const modules = [
  {
    num: "01",
    title: "Configuración Inicial",
    desc: "Aprenderás a preparar el entorno local y verificar que el modelo funcione correctamente con una generación de texto simple.",
    topics: ["Instalación de Ollama", "Descarga de modelos (Llama, Mistral)", "Verificación del entorno", "Primera generación de texto"],
  },
  {
    num: "02",
    title: "Implementación Básica y Personalización",
    desc: "Explorarás cómo generar texto, ajustar parámetros y construir un chatbot interactivo en la terminal.",
    topics: ["Parámetros: temperatura, top-p", "Optimización CPU vs GPU", "Cuantización de modelos", "Chatbot interactivo en terminal"],
  },
  {
    num: "03",
    title: "Aplicaciones Avanzadas",
    desc: "Aplicarás LLMs para clasificación de sentimientos y generación de resúmenes personalizados usando prompts propios.",
    topics: ["Clasificación de sentimientos", "Resumen automático de textos", "Diseño de prompts avanzados", "Proyecto final aplicado"],
  },
];

const related = [
  {
    title: "Large Language Models",
    professor: "Martin Arispe",
    href: "/llms",
    image: "/assets/cursos/large_language_models.png",
    tagClass: "tag-ai",
    tag: "IA",
  },
  {
    title: "Knowledge Graphs",
    professor: "Martin Arispe",
    href: "/kg",
    image: "/assets/cursos/knowledge_graphs.png",
    tagClass: "tag-ai",
    tag: "IA",
  },
];
---
<Layout title={course.title} description={course.subtitle}>
  <div class="breadcrumb"><a href="/">Inicio</a><span>›</span><a href="/cursos">Cursos</a><span>›</span><span class="bc-cur">{course.title}</span></div>

  <section class="hero">
    <div class="hero-content">
      <div class="hero-meta">
        <span class={`tag ${course.tagClass}`}>{course.area}</span>
        <span class="level-badge">{course.level}</span>
        <span class="dur-badge">⏱ {course.hours}</span>
      </div>
      <h1>{course.title}</h1>
      <p class="hero-desc">{course.subtitle}</p>
      <div class="hero-stats">
        <div class="hs"><span class="hs-n">{modules.length}</span><span class="hs-l">Módulos</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">{course.hours}</span><span class="hs-l">Duración</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">Español</span><span class="hs-l">Idioma</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">✓</span><span class="hs-l">Certificado</span></div>
      </div>
      <div class="hero-actions">
        <a href="/#precios" target="_blank" class="btn-primary btn-lg">Inscribirme ahora</a>
        <a href="#modulos" class="btn-secondary">Ver contenido →</a>
      </div>
      <div class="trust-row"><span>✔ Acceso anual</span><span>✔ Certificado oficial Delve</span><span>✔ Aprende a tu ritmo</span></div>
    </div>
    <div class="hero-right">
      <div class="course-img-card">
        <img src={course.image} alt={course.title} />
        <div class="img-overlay"><span class="overlay-tag">{course.area}</span></div>
      </div>
      <div class="floating-cta">
        
        <a href="/#precios" target="_blank" class="btn-primary fca-btn">Inscribirme ahora</a>
        <div class="fca-includes">
          <div class="fca-inc-title">Acceso Founder incluye:</div>
          <ul><li>Todos los cursos</li><li>Certificados verificables</li><li>Sesiones en vivo mensuales</li></ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section learnings-section">
    <div class="learnings-inner">
      <div><span class="label">Resultados de aprendizaje</span><h2 class="section-title">Lo que aprenderás</h2></div>
      <div class="learnings-grid">
        {learnings.map(item => (<div class="learning-item"><span class="l-check">→</span><span>{item}</span></div>))}
      </div>
    </div>
  </section>

  <section class="section modules-section" id="modulos">
    <span class="label">Plan de estudio</span>
    <h2 class="section-title">Contenido del curso</h2>
    <div class="modules-list">
      {modules.map(mod => (
        <div class="module-item">
          <div class="mod-header">
            <div class="mod-num-wrap"><span class="mod-num">{mod.num}</span></div>
            <div class="mod-title-wrap"><h3>{mod.title}</h3><p class="mod-desc">{mod.desc}</p></div>
            <button class="mod-toggle" aria-label="Expandir">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </div>
          <div class="mod-topics">
            <ul>{mod.topics.map(t => (<li><span class="topic-arrow">→</span>{t}</li>))}</ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section professor-section">
    <span class="label">Quién enseña</span>
    <h2 class="section-title">Conoce al profesor</h2>
    <div class="prof-card">
      <div class="prof-img-wrap">
        <img src={professor.image} alt={professor.name} onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
        <div class="prof-avatar-fallback">{professor.initials}</div>
      </div>
      <div class="prof-info">
        <div class="prof-name-row"><h3>{professor.name}</h3><span class={`tag ${course.tagClass}`}>{course.area}</span></div>
        <p class="prof-bio">{professor.bio}</p>
        <div class="prof-tags">{professor.tags.map(t => <span class="prof-tag">{t}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="section related-section">
    <span class="label">Continúa aprendiendo</span>
    <h2 class="section-title">Cursos relacionados</h2>
    <div class="related-grid">
      {related.map(c => (
        <a href={c.href} class="related-card">
          <div class="rel-img"><img src={c.image} alt={c.title} loading="lazy" /></div>
          <div class="rel-body"><span class={`tag ${c.tagClass}`}>{c.tag}</span><h3>{c.title}</h3><p>Prof. {c.professor}</p><span class="rel-cta">Ver curso →</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="section bottom-cta-section">
    <div class="bottom-cta">
      <h2>¿Listo para correr LLMs en tu propia máquina?</h2>
      <p>Únete al Acceso Founder y obtén este curso y más.</p>
      <div class="bottom-btns">
        <a href="/#precios" target="_blank" class="btn-primary btn-lg">Inscribirme ahora</a>
        <a href="/cursos" class="btn-secondary">Ver todos los cursos</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumb{display:flex;align-items:center;gap:8px;padding:18px var(--px);font-size:12px;color:var(--text-muted);border-bottom:0.5px solid var(--border)}
  .breadcrumb a{color:var(--text-muted);transition:color .15s}.breadcrumb a:hover{color:var(--accent)}.bc-cur{color:var(--text-secondary)}
  .hero{display:grid;grid-template-columns:1fr 420px;gap:56px;padding:64px var(--px) 72px;border-bottom:0.5px solid var(--border);align-items:start}
  .hero-meta{display:flex;align-items:center;gap:10px;margin-bottom:20px;flex-wrap:wrap}
  .level-badge{font-size:12px;color:var(--accent);background:var(--accent-dim);border:0.5px solid var(--accent-border);padding:3px 12px;border-radius:20px;font-weight:500}
  .dur-badge{font-size:12px;color:var(--text-muted);border:0.5px solid var(--border);padding:3px 12px;border-radius:20px}
  .hero-content h1{font-family:var(--font-display);font-size:52px;font-weight:800;letter-spacing:-2px;color:#fff;line-height:1.05;margin-bottom:20px}
  .hero-content h1 em{color:var(--accent);font-style:normal}
  .hero-desc{font-size:16px;color:var(--text-secondary);line-height:1.75;font-weight:300;margin-bottom:32px;max-width:520px}
  .hero-stats{display:flex;align-items:center;margin-bottom:36px;background:rgba(255,255,255,.03);border:0.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;width:fit-content}
  .hs{display:flex;flex-direction:column;align-items:center;padding:16px 24px;gap:4px}
  .hs-n{font-family:var(--font-display);font-size:22px;font-weight:700;color:#fff}
  .hs-l{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px}
  .hs-div{width:0.5px;height:40px;background:var(--border)}
  .hero-actions{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap}
  .btn-lg{padding:15px 32px;font-size:15px}
  .trust-row{display:flex;gap:20px;flex-wrap:wrap;font-size:13px;color:var(--text-muted)}
  .hero-right{display:flex;flex-direction:column;gap:16px}
  .course-img-card{border-radius:var(--radius-xl);overflow:hidden;border:0.5px solid var(--border);position:relative}
  .course-img-card img{width:100%;height:240px;object-fit:cover;display:block}
  .img-overlay{position:absolute;bottom:12px;left:12px}
  .overlay-tag{background:rgba(5,10,20,.75);backdrop-filter:blur(8px);border:0.5px solid var(--border-hover);border-radius:20px;padding:5px 14px;font-size:12px;color:rgba(255,255,255,.7)}
  .floating-cta{background:rgba(255,255,255,.03);border:0.5px solid rgba(255,255,255,.1);border-radius:var(--radius-xl);padding:24px}
  .fca-price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:16px}
  .fca-price{font-family:var(--font-display);font-size:36px;font-weight:800;color:#fff}
  .fca-price span{font-size:16px;font-weight:400;color:var(--text-muted)}.fca-note{font-size:12px;color:var(--text-muted)}
  .fca-btn{display:block;text-align:center;width:100%;padding:13px;margin-bottom:20px;font-size:14px}
  .fca-includes{border-top:0.5px solid var(--border);padding-top:16px}
  .fca-inc-title{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
  .fca-includes ul{display:flex;flex-direction:column;gap:6px}
  .fca-includes li{font-size:13px;color:var(--text-secondary);display:flex;gap:8px;align-items:center}
  .fca-includes li::before{content:'→';color:var(--accent);font-size:11px}
  .section{padding:72px var(--px)}
  .learnings-section{background:rgba(255,255,255,.01);border-bottom:0.5px solid var(--border)}
  .learnings-inner{display:grid;grid-template-columns:280px 1fr;gap:64px;align-items:start}
  .learnings-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .learning-item{display:flex;align-items:flex-start;gap:10px;background:rgba(255,255,255,.03);border:0.5px solid var(--border);border-radius:var(--radius-md);padding:14px 16px;font-size:13px;color:var(--text-secondary);line-height:1.5}
  .l-check{color:var(--accent);flex-shrink:0;font-size:12px;margin-top:1px}
  .modules-section{border-bottom:0.5px solid var(--border)}
  .modules-list{display:flex;flex-direction:column;gap:0}
  .module-item{border:0.5px solid var(--border);border-radius:var(--radius-lg);margin-bottom:10px;overflow:hidden;transition:border-color .15s}
  .module-item:hover{border-color:var(--border-hover)}.module-item.open{border-color:var(--accent-border)}
  .mod-header{display:grid;grid-template-columns:64px 1fr 40px;gap:20px;align-items:center;padding:22px 24px;cursor:pointer;background:rgba(255,255,255,.02);transition:background .15s}
  .mod-header:hover{background:rgba(255,255,255,.04)}
  .mod-num-wrap{width:44px;height:44px;border-radius:var(--radius-md);background:var(--accent-dim);border:0.5px solid var(--accent-border);display:flex;align-items:center;justify-content:center}
  .mod-num{font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--accent)}
  .mod-title-wrap h3{font-family:var(--font-display);font-size:16px;font-weight:700;color:#fff;margin-bottom:4px}
  .mod-desc{font-size:13px;color:var(--text-secondary);line-height:1.5}
  .mod-toggle{background:none;border:0.5px solid var(--border);color:var(--text-muted);width:32px;height:32px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;justify-self:end;cursor:pointer}
  .module-item.open .mod-toggle svg{transform:rotate(180deg)}
  .mod-topics{display:none;padding:0 24px 20px 88px;border-top:0.5px solid var(--border);background:rgba(255,255,255,.01)}
  .module-item.open .mod-topics{display:block}
  .mod-topics ul{display:flex;flex-direction:column;gap:0;padding-top:16px}
  .mod-topics li{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text-secondary);padding:8px 0;border-bottom:0.5px solid rgba(255,255,255,.04)}
  .mod-topics li:last-child{border-bottom:none}.topic-arrow{color:var(--accent);font-size:11px;flex-shrink:0}
  .professor-section{background:rgba(255,255,255,.01);border-bottom:0.5px solid var(--border)}
  .prof-card{display:grid;grid-template-columns:200px 1fr;gap:40px;align-items:start;background:rgba(255,255,255,.03);border:0.5px solid var(--border);border-radius:var(--radius-xl);padding:36px}
  .prof-img-wrap{width:160px;height:160px;border-radius:var(--radius-lg);overflow:hidden;border:0.5px solid var(--border);position:relative}
  .prof-img-wrap img{width:100%;height:100%;object-fit:cover;display:block}
  .prof-avatar-fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:var(--accent-dim);font-family:var(--font-display);font-size:32px;font-weight:700;color:var(--accent)}
  .prof-name-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap}
  .prof-name-row h3{font-family:var(--font-display);font-size:22px;font-weight:700;color:#fff}
  .prof-bio{font-size:14px;color:var(--text-secondary);line-height:1.75;margin-bottom:20px;font-weight:300}
  .prof-tags{display:flex;gap:8px;flex-wrap:wrap}
  .prof-tag{font-size:12px;color:var(--text-secondary);background:rgba(255,255,255,.05);border:0.5px solid var(--border-hover);padding:4px 12px;border-radius:20px}
  .related-section{border-bottom:0.5px solid var(--border)}
  .related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .related-card{background:var(--bg-surface);border:0.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;display:flex;flex-direction:column;transition:border-color .2s,transform .15s}
  .related-card:hover{border-color:var(--accent-border);transform:translateY(-2px)}
  .rel-img{height:140px;overflow:hidden}.rel-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
  .related-card:hover .rel-img img{transform:scale(1.04)}
  .rel-body{padding:18px;display:flex;flex-direction:column;gap:6px;flex:1}
  .rel-body h3{font-family:var(--font-display);font-size:15px;font-weight:700;color:#fff;line-height:1.3}
  .rel-body p{font-size:12px;color:var(--text-muted);flex:1}.rel-cta{font-size:12px;color:var(--accent)}
  .bottom-cta-section{padding-top:0;padding-bottom:80px}
  .bottom-cta{background:linear-gradient(135deg,rgba(61,255,182,.05) 0%,rgba(139,92,246,.05) 100%);border:0.5px solid var(--accent-border);border-radius:var(--radius-xl);padding:56px;text-align:center}
  .bottom-cta h2{font-family:var(--font-display);font-size:34px;font-weight:700;color:#fff;letter-spacing:-1px;margin-bottom:12px}
  .bottom-cta p{font-size:16px;color:var(--text-secondary);margin-bottom:32px;font-weight:300}
  .bottom-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  @media(max-width:1024px){.hero{grid-template-columns:1fr;gap:40px}.hero-right{order:-1}.learnings-inner{grid-template-columns:1fr;gap:24px}.prof-card{grid-template-columns:1fr}.prof-img-wrap{width:100px;height:100px}}
  @media(max-width:768px){.hero-content h1{font-size:36px;letter-spacing:-1.5px}.learnings-grid{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr}.mod-header{grid-template-columns:48px 1fr 36px;gap:12px;padding:16px}.mod-topics{padding-left:16px}.bottom-cta{padding:36px 24px}.bottom-cta h2{font-size:24px}.hero-stats{width:100%}.hs{padding:12px 16px}}
</style>

<script>
  document.querySelectorAll('.mod-header').forEach(header => {
    header.addEventListener('click', () => {
      const item = header.closest('.module-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.module-item').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });
  document.querySelector('.module-item')?.classList.add('open');
</script>

