<script>
  document.querySelectorAll('.mod-header').forEach(header => {
    header.addEventListener('click', () => {
      const item = header.closest('.module-item');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.module-item').forEach(el => el.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });
  document.querySelector('.module-item')?.classList.add('open');
</script>
