---
import Layout from '../layouts/Layout.astro';

const course = {
  title: 'Fundamentos de Deep Learning',
  subtitle: 'Descubre cómo funcionan las redes neuronales y aplícalas en casos reales.',
  level: 'Básico',
  hours: '5 horas',
  area: 'Inteligencia Artificial',
  tagClass: 'tag-ai',
  image: '/assets/cursos/fundamentos_de_deep_learning.png',
};

const professor = {
  name: 'Oscar Contreras',
  image: '/assets/mentores/oscar_contreras.png',
  initials: 'OC',
  bio: 'Realizó su licenciatura en Ingeniería de Sistemas y posteriormente obtuvo una Maestría en Informática Avanzada por la Universidad de Bristol (Reino Unido). Cuenta con amplia experiencia en Ingeniería de Software e Ingeniería de Datos.',
  tags: ['Deep Learning', 'Ingeniería de Datos', 'Universidad de Bristol'],
};

const learnings = [
  'Aprenderás los fundamentos de las redes neuronales',
  'Entenderás los conceptos clave del Deep Learning y sus aplicaciones',
  'Dominarás la matemática de una neurona artificial',
  'Explorarás cómo fluye la información en una red (forward propagation)',
  'Comprenderás cómo aprenden las redes con backpropagation y optimización',
  'Implementarás redes neuronales con Keras y PyTorch',
];

const modules = [
  {
    num: '01',
    title: 'Fundamentos Conceptuales de Deep Learning',
    desc: 'Se presentarán los conceptos básicos del Deep Learning, incluyendo qué son las redes neuronales, sus aplicaciones, diferencias entre neuronas naturales y artificiales, y una introducción a los modelos como la regresión logística.',
    topics: [
      '¿Qué es el Deep Learning?',
      'Redes neuronales vs. neurona biológica',
      'Aplicaciones reales en la industria',
      'Introducción a la regresión logística',
    ],
  },
  {
    num: '02',
    title: 'Modelado Matemático de Neuronas Artificiales',
    desc: 'Se explorará el funcionamiento interno de las neuronas artificiales desde una perspectiva matemática, abarcando funciones de activación como la sigmoidal, su implementación práctica, y cómo se construyen redes feedforward.',
    topics: [
      'Funciones de activación: sigmoide, ReLU, tanh',
      'Pesos, sesgos y transformaciones lineales',
      'Construcción de redes feedforward',
      'Representación matricial de capas',
    ],
  },
  {
    num: '03',
    title: 'Propagación hacia Adelante (Forward Propagation)',
    desc: 'Este módulo se enfocará en cómo fluye la información a través de una red neuronal, cubriendo la propagación hacia adelante, las expresiones matemáticas involucradas, y el entrenamiento básico de una red.',
    topics: [
      'Flujo de información en capas',
      'Cálculo de activaciones por capa',
      'Predicciones con una red simple',
      'Entrenamiento básico paso a paso',
    ],
  },
  {
    num: '04',
    title: 'Propagación hacia Atrás (Backward Propagation)',
    desc: 'Se explicará cómo las redes neuronales aprenden mediante la retropropagación del error, abordando funciones de pérdida, descenso del gradiente y otros métodos de optimización para ajustar los pesos de la red.',
    topics: [
      'Funciones de pérdida: MSE, Cross-Entropy',
      'Regla de la cadena y gradientes',
      'Descenso del gradiente (SGD, Adam)',
      'Actualización de pesos de la red',
    ],
  },
  {
    num: '05',
    title: 'Implementación de Redes Neuronales en Keras y PyTorch',
    desc: 'En este módulo final se aplicará lo aprendido para implementar redes neuronales reales utilizando las librerías Keras y PyTorch, incluyendo exploración de arquitecturas alternativas y un cierre del curso.',
    topics: [
      'Construcción de modelos con Keras',
      'Entrenamiento y evaluación en PyTorch',
      'Arquitecturas alternativas: CNN, RNN intro',
      'Proyecto final: clasificador de imágenes',
    ],
  },
];

const related = [
  {
    title: 'Introducción a Computer Vision',
    professor: 'Emily Rivera',
    href: '/icv',
    image: '/assets/cursos/introduccion_a_computer_vision.png',
    tagClass: 'tag-ai',
    tag: 'Inteligencia Artificial',
  },
  {
    title: 'Deep Learning para Computer Vision',
    professor: 'Erick Maraz',
    href: '/dlxcv',
    image: '/assets/cursos/deep_learning_para_computer_vision.png',
    tagClass: 'tag-ai',
    tag: 'Inteligencia Artificial',
  },
];
---

<Layout title={course.title} description={course.subtitle}>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href="/">Inicio</a>
    <span>›</span>
    <a href="/cursos">Cursos</a>
    <span>›</span>
    <span class="bc-cur">{course.title}</span>
  </div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-meta">
        <span class={`tag ${course.tagClass}`}>{course.area}</span>
        <span class="level-badge">{course.level}</span>
        <span class="dur-badge">⏱ {course.hours}</span>
      </div>

      <h1>Fundamentos de<br /><em>Deep Learning</em></h1>

      <p class="hero-desc">{course.subtitle}</p>

      <div class="hero-stats">
        <div class="hs"><span class="hs-n">{modules.length}</span><span class="hs-l">Módulos</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">{course.hours}</span><span class="hs-l">Duración</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">Español</span><span class="hs-l">Idioma</span></div>
        <div class="hs-div"></div>
        <div class="hs"><span class="hs-n">✓</span><span class="hs-l">Certificado</span></div>
      </div>

      <div class="hero-actions">
        <a href="https://forms.gle/fknvV9x2rLHyrF4N7" target="_blank" class="btn-primary btn-lg">Inscribirme ahora</a>
        <a href="#modulos" class="btn-secondary">Ver contenido →</a>
      </div>

      <div class="trust-row">
        <span>✔ Acceso anual</span>
        <span>✔ Certificado oficial Delve</span>
        <span>✔ Sin conocimientos previos requeridos</span>
      </div>
    </div>

    <div class="hero-right">
      <div class="course-img-card">
        <img src={course.image} alt={course.title} />
        <div class="img-overlay"><span class="overlay-tag">{course.area}</span></div>
      </div>
      <div class="floating-cta">
        <div class="fca-price-row">
          <span class="fca-price">$9<span>/mes</span></span>
          <span class="fca-note">Con Acceso Founder</span>
        </div>
        <a href="https://forms.gle/fknvV9x2rLHyrF4N7" target="_blank" class="btn-primary fca-btn">
          Inscribirme ahora
        </a>
        <div class="fca-includes">
          <div class="fca-inc-title">Acceso Founder incluye:</div>
          <ul>
            <li>Este curso + 19 más</li>
            <li>Certificados verificables</li>
            <li>Sesiones en vivo mensuales</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DESCRIPCIÓN -->
  <section class="section desc-section">
    <div class="desc-inner">
      <div>
        <span class="label">Sobre este curso</span>
        <h2 class="section-title">Descripción</h2>
      </div>
      <p class="desc-text">
        Explora el poder del Deep Learning con este curso diseñado para llevarte desde los conceptos
        fundamentales hasta la implementación de redes neuronales con Keras y PyTorch. A lo largo del
        curso comprenderás cómo funcionan las redes neuronales desde cero, dominarás los principios
        matemáticos que las sustentan, y aprenderás a entrenarlas eficazmente utilizando técnicas
        modernas de propagación hacia adelante y hacia atrás. Este curso es ideal para quienes buscan
        iniciarse en el mundo de Deep Learning o fortalecer su base técnica con un enfoque claro,
        práctico y orientado a resultados reales.
      </p>
    </div>
  </section>

  <!-- LO QUE APRENDERÁS -->
  <section class="section learnings-section">
    <div class="learnings-inner">
      <div>
        <span class="label">Resultados de aprendizaje</span>
        <h2 class="section-title">Lo que aprenderás</h2>
      </div>
      <div class="learnings-grid">
        {learnings.map(item => (
          <div class="learning-item">
            <span class="l-check">→</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MÓDULOS -->
  <section class="section modules-section" id="modulos">
    <span class="label">Plan de estudio</span>
    <h2 class="section-title">Contenido del curso</h2>

    <div class="modules-list">
      {modules.map(mod => (
        <div class="module-item">
          <div class="mod-header">
            <div class="mod-num-wrap"><span class="mod-num">{mod.num}</span></div>
            <div class="mod-title-wrap">
              <h3>{mod.title}</h3>
              <p class="mod-desc">{mod.desc}</p>
            </div>
            <button class="mod-toggle" aria-label="Expandir módulo">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <div class="mod-topics">
            <ul>
              {mod.topics.map(t => (
                <li><span class="topic-arrow">→</span>{t}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROFESOR -->
  <section class="section professor-section">
    <span class="label">Quién enseña</span>
    <h2 class="section-title">Conoce al profesor</h2>

    <div class="prof-card">
      <div class="prof-img-wrap">
        <img
          src={professor.image}
          alt={professor.name}
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        />
        <div class="prof-avatar-fallback">{professor.initials}</div>
      </div>
      <div class="prof-info">
        <div class="prof-name-row">
          <h3>{professor.name}</h3>
          <span class={`tag ${course.tagClass}`}>{course.area}</span>
        </div>
        <p class="prof-bio">{professor.bio}</p>
        <div class="prof-tags">
          {professor.tags.map(t => <span class="prof-tag">{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- RELACIONADOS -->
  <section class="section related-section">
    <span class="label">Continúa aprendiendo</span>
    <h2 class="section-title">Cursos relacionados</h2>
    <div class="related-grid">
      {related.map(c => (
        <a href={c.href} class="related-card">
          <div class="rel-img">
            <img src={c.image} alt={c.title} loading="lazy" />
          </div>
          <div class="rel-body">
            <span class={`tag ${c.tagClass}`}>{c.tag}</span>
            <h3>{c.title}</h3>
            <p>Prof. {c.professor}</p>
            <span class="rel-cta">Ver curso →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section bottom-cta-section">
    <div class="bottom-cta">
      <h2>¿Listo para dominar el Deep Learning?</h2>
      <p>Únete al Acceso Founder y obtén este curso y 19 más por $9/mes.</p>
      <div class="bottom-btns">
        <a href="https://forms.gle/fknvV9x2rLHyrF4N7" target="_blank" class="btn-primary btn-lg">
          Inscribirme ahora
        </a>
        <a href="/cursos" class="btn-secondary">Ver todos los cursos</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* BREADCRUMB */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 18px var(--px);
    font-size: 12px;
    color: var(--text-muted);
    border-bottom: 0.5px solid var(--border);
  }
  .breadcrumb a { color: var(--text-muted); transition: color .15s; }
  .breadcrumb a:hover { color: var(--accent); }
  .bc-cur { color: var(--text-secondary); }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    padding: 64px var(--px) 72px;
    border-bottom: 0.5px solid var(--border);
    align-items: start;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .level-badge {
    font-size: 12px;
    color: var(--accent);
    background: var(--accent-dim);
    border: 0.5px solid var(--accent-border);
    padding: 3px 12px;
    border-radius: 20px;
    font-weight: 500;
  }

  .dur-badge {
    font-size: 12px;
    color: var(--text-muted);
    border: 0.5px solid var(--border);
    padding: 3px 12px;
    border-radius: 20px;
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 800;
    letter-spacing: -2px;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 20px;
  }

  .hero-content h1 em { color: var(--accent); font-style: normal; }

  .hero-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.75;
    font-weight: 300;
    margin-bottom: 32px;
    max-width: 520px;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    margin-bottom: 36px;
    background: rgba(255,255,255,.03);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: fit-content;
  }

  .hs { display: flex; flex-direction: column; align-items: center; padding: 16px 24px; gap: 4px; }
  .hs-n { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: #fff; }
  .hs-l { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; }
  .hs-div { width: 0.5px; height: 40px; background: var(--border); }

  .hero-actions { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .btn-lg { padding: 15px 32px; font-size: 15px; }

  .trust-row { display: flex; gap: 20px; flex-wrap: wrap; font-size: 13px; color: var(--text-muted); }

  /* HERO RIGHT */
  .hero-right { display: flex; flex-direction: column; gap: 16px; }

  .course-img-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 0.5px solid var(--border);
    position: relative;
  }

  .course-img-card img { width: 100%; height: 240px; object-fit: cover; display: block; }

  .img-overlay { position: absolute; bottom: 12px; left: 12px; }
  .overlay-tag {
    background: rgba(5,10,20,.75);
    backdrop-filter: blur(8px);
    border: 0.5px solid var(--border-hover);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    color: rgba(255,255,255,.7);
  }

  .floating-cta {
    background: rgba(255,255,255,.03);
    border: 0.5px solid rgba(255,255,255,.1);
    border-radius: var(--radius-xl);
    padding: 24px;
  }

  .fca-price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 16px; }
  .fca-price { font-family: var(--font-display); font-size: 36px; font-weight: 800; color: #fff; }
  .fca-price span { font-size: 16px; font-weight: 400; color: var(--text-muted); }
  .fca-note { font-size: 12px; color: var(--text-muted); }

  .fca-btn { display: block; text-align: center; width: 100%; padding: 13px; margin-bottom: 20px; font-size: 14px; }

  .fca-includes { border-top: 0.5px solid var(--border); padding-top: 16px; }
  .fca-inc-title { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 10px; }
  .fca-includes ul { display: flex; flex-direction: column; gap: 6px; }
  .fca-includes li { font-size: 13px; color: var(--text-secondary); display: flex; gap: 8px; align-items: center; }
  .fca-includes li::before { content: '→'; color: var(--accent); font-size: 11px; }

  /* SECTIONS */
  .section { padding: 72px var(--px); }

  /* DESCRIPTION */
  .desc-section {
    background: rgba(255,255,255,.01);
    border-bottom: 0.5px solid var(--border);
  }
  .desc-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    align-items: start;
  }
  .desc-text {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.8;
    font-weight: 300;
  }

  /* LEARNINGS */
  .learnings-section { border-bottom: 0.5px solid var(--border); }
  .learnings-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 64px;
    align-items: start;
  }
  .learnings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .learning-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(255,255,255,.03);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .l-check { color: var(--accent); flex-shrink: 0; font-size: 12px; margin-top: 1px; }

  /* MODULES */
  .modules-section { border-bottom: 0.5px solid var(--border); }
  .modules-list { display: flex; flex-direction: column; gap: 0; }

  .module-item {
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 10px;
    overflow: hidden;
    transition: border-color .15s;
  }
  .module-item:hover { border-color: var(--border-hover); }
  .module-item.open { border-color: var(--accent-border); }

  .mod-header {
    display: grid;
    grid-template-columns: 64px 1fr 40px;
    gap: 20px;
    align-items: center;
    padding: 22px 24px;
    cursor: pointer;
    background: rgba(255,255,255,.02);
    transition: background .15s;
  }
  .mod-header:hover { background: rgba(255,255,255,.04); }

  .mod-num-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--accent-dim);
    border: 0.5px solid var(--accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mod-num { font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--accent); }

  .mod-title-wrap h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }
  .mod-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

  .mod-toggle {
    background: none;
    border: 0.5px solid var(--border);
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .2s;
    flex-shrink: 0;
    justify-self: end;
    cursor: pointer;
  }
  .module-item.open .mod-toggle svg { transform: rotate(180deg); }

  .mod-topics {
    display: none;
    padding: 0 24px 20px 88px;
    border-top: 0.5px solid var(--border);
    background: rgba(255,255,255,.01);
  }
  .module-item.open .mod-topics { display: block; }

  .mod-topics ul { display: flex; flex-direction: column; gap: 0; padding-top: 16px; }
  .mod-topics li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
    padding: 8px 0;
    border-bottom: 0.5px solid rgba(255,255,255,.04);
  }
  .mod-topics li:last-child { border-bottom: none; }
  .topic-arrow { color: var(--accent); font-size: 11px; flex-shrink: 0; }

  /* PROFESSOR */
  .professor-section {
    background: rgba(255,255,255,.01);
    border-bottom: 0.5px solid var(--border);
  }
  .prof-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    align-items: start;
    background: rgba(255,255,255,.03);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 36px;
  }
  .prof-img-wrap {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--border);
    position: relative;
  }
  .prof-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .prof-avatar-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--accent-dim);
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--accent);
  }
  .prof-name-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .prof-name-row h3 { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: #fff; }
  .prof-bio { font-size: 14px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 20px; font-weight: 300; }
  .prof-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .prof-tag {
    font-size: 12px;
    color: var(--text-secondary);
    background: rgba(255,255,255,.05);
    border: 0.5px solid var(--border-hover);
    padding: 4px 12px;
    border-radius: 20px;
  }

  /* RELATED */
  .related-section { border-bottom: 0.5px solid var(--border); }
  .related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .related-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color .2s, transform .15s;
  }
  .related-card:hover { border-color: var(--accent-border); transform: translateY(-2px); }
  .rel-img { height: 140px; overflow: hidden; }
  .rel-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .related-card:hover .rel-img img { transform: scale(1.04); }
  .rel-body { padding: 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .rel-body h3 { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: #fff; line-height: 1.3; }
  .rel-body p { font-size: 12px; color: var(--text-muted); flex: 1; }
  .rel-cta { font-size: 12px; color: var(--accent); }

  /* BOTTOM CTA */
