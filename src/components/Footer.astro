---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      
      <a href="/"><img src="/assets/logo.png" width="60"/></a>
      <p>Impulsando el futuro DeepTech en Latinoamérica.</p>
    </div>
    <div class="footer-links">
      <div class="col">
        <span class="col-title">Educación</span>
        <br>
        <a href="/cursos">Cursos</a>
        <a href="/programas">Programas</a>
        <a href="/empresas">Para Empresas</a>
      </div>
      <div class="col">
        <span class="col-title">Empresa</span>
        <a href="/nosotros">Nosotros</a>
        <a href="/contacto">Contacto</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Delve Educación</span>
    <span class="accel">Acelerado por <strong>Aceleratec</strong></span>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.5px solid var(--border);
    padding: 48px var(--px) 32px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    margin-bottom: 40px;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    display: block;
    margin-bottom: 12px;
  }

  .accent { color: var(--accent); }

  .footer-left p {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 240px;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    gap: 64px;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .col a {
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .col a:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 0.5px solid var(--border);
    font-size: 12px;
    color: var(--text-muted);
  }

  .accel strong { color: var(--text-secondary); }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; gap: 32px; }
    .footer-links { gap: 32px; }
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>